# Server Configuration
API_ADDR=:8080
PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=energy_grid
DB_SSLMODE=disable

# AWS Configuration
USE_CLOUD_SERVICES=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# DynamoDB Tables
DYNAMODB_SENSORS_TABLE=energy-sensors
DYNAMODB_READINGS_TABLE=energy-readings
DYNAMODB_ALERTS_TABLE=energy-alerts

# S3 Configuration
S3_BUCKET=energy-grid-data
S3_READINGS_PREFIX=readings/
S3_ANALYTICS_PREFIX=analytics/

# SNS Configuration
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:energy-alerts

# Lambda Functions
LAMBDA_ANALYTICS_FUNCTION=analytics-processing
LAMBDA_ANOMALY_FUNCTION=anomaly-detection

# Application Settings
LOG_LEVEL=info
ENVIRONMENT=development
